# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=KPServicePro
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push VAPID Keys (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@kpservicepro.com

# LINE OA Integration (Optional - per tenant config in dashboard)
# LINE_CHANNEL_SECRET and LINE_CHANNEL_ACCESS_TOKEN are stored per-tenant in database

# Platform LINE OA (used to send subscription renewal notifications
# to shop owners about KPServicePro itself, not their customers)
PLATFORM_LINE_CHANNEL_SECRET=
PLATFORM_LINE_CHANNEL_ACCESS_TOKEN=
PLATFORM_LINE_BASIC_ID=             # e.g. @kpservicepro
PLATFORM_LINE_LIFF_ID=               # optional, for in-LINE web pages

# Cron secret used to authenticate Vercel Cron / external schedulers
CRON_SECRET=change-me-to-a-long-random-string

# Platform PromptPay / bank info (for subscription renewal payments)
# Used to generate PromptPay QR via promptpay.io for shop owners paying us.
PLATFORM_PROMPTPAY_ID=                # phone (10 digits, leading 0) or 13-digit ID
PLATFORM_PROMPTPAY_NAME=KPServicePro
PLATFORM_BANK_NAME=                   # e.g. SCB / KTB / BBL
PLATFORM_BANK_ACCOUNT=                # e.g. 123-4-56789-0 / KPServicePro Co., Ltd.
PLATFORM_ACCEPT_CREDIT_CARD=false     # 'true' to show credit-card slip option

# Vercel Domains API — used for the per-tenant Custom Domain add-on.
# Generate a token in Vercel Account Settings > Tokens with project scope.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=                    # prj_xxxxxxxxxxxxxxxxxxxx
VERCEL_TEAM_ID=                       # team_xxxxxxxxxxxxxxxxxxxx (only if project is in a team)
